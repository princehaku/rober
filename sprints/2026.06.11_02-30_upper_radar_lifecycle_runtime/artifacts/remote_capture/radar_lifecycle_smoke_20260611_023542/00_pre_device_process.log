191860 zsh -c set -eu ART=/tmp/radar_lifecycle_smoke_$(date +%Y%m%d_%H%M%S) mkdir -p "$ART" echo "$ART" > /tmp/rober_radar_lifecycle_last_artifact_dir.txt {   date   hostname   echo "--- devices ---"   ls -l /dev/ttyS5 /dev/ttyACM0 2>&1 || true   echo "--- by-id ---"   ls -l /dev/serial/by-id 2>&1 || true   echo "--- lsof before ---"   lsof /dev/ttyS5 /dev/ttyACM0 2>&1 || true   echo "--- pgrep before ---"   pgrep -af "o1_lidar_lifecycle|lidar_driver|static_transform_publisher|ros2 run ros2_trashbot_hardware lidar_driver" 2>&1 || true } >"$ART/00_pre_device_process.log" curl -sS -X POST http://127.0.0.1:8787/api/radar/start >"$ART/01_api_radar_start.json" 2>"$ART/01_api_radar_start.stderr" || true sleep 8 curl -sS http://127.0.0.1:8787/api/radar/status >"$ART/02_api_radar_status_after_start.json" 2>"$ART/02_api_radar_status_after_start.stderr" || true # lifecycle 常驻后，用 read-only collector 刷新证明，不再启动临时 smoke runtime。 curl -sS -X POST http://127.0.0.1:8787/api/radar/scan-proof/refresh \   -H "Content-Type: application/json" \   -d "{\"start_runtime\":false,\"timeout_s\":12}" \   >"$ART/03_api_scan_proof_refresh_live.json" 2>"$ART/03_api_scan_proof_refresh_live.stderr" || true {   echo "--- lsof during ---"   lsof /dev/ttyS5 /dev/ttyACM0 2>&1 || true   echo "--- fuser during ---"   fuser -v /dev/ttyS5 /dev/ttyACM0 2>&1 || true   echo "--- pgrep during ---"   pgrep -af "o1_lidar_lifecycle|lidar_driver|static_transform_publisher|ros2 run ros2_trashbot_hardware lidar_driver" 2>&1 || true   echo "--- lifecycle status cli ---"   bash /root/rober/onboard/scripts/o1_lidar_lifecycle.sh status 2>&1 || true   echo "--- ros topic list ---"   bash -lc "source /opt/ros/humble/setup.bash && source /root/rober/onboard/install/setup.bash && timeout 8 ros2 topic list" 2>&1 || true } >"$ART/04_during_device_process.log" curl -sS -X POST http://127.0.0.1:8787/api/radar/stop >"$ART/05_api_radar_stop.json" 2>"$ART/05_api_radar_stop.stderr" || true sleep 3 {   echo "--- lsof after stop ---"   lsof /dev/ttyS5 /dev/ttyACM0 2>&1 || true   echo "--- fuser after stop ---"   fuser -v /dev/ttyS5 /dev/ttyACM0 2>&1 || true   echo "--- pgrep after stop ---"   pgrep -af "o1_lidar_lifecycle|lidar_driver|static_transform_publisher|ros2 run ros2_trashbot_hardware lidar_driver" 2>&1 || true   echo "--- lifecycle status cli ---"   bash /root/rober/onboard/scripts/o1_lidar_lifecycle.sh status 2>&1 || true } >"$ART/06_after_stop_device_process.log" curl -sS http://127.0.0.1:8787/api/radar/status >"$ART/07_api_radar_status_after_stop.json" 2>"$ART/07_api_radar_status_after_stop.stderr" || true python3 - "$ART" <<"PY" >"$ART/summary.json" import json, sys from pathlib import Path root = Path(sys.argv[1]) def load(name):     try:         return json.loads((root / name).read_text())     except Exception as exc:         return {"load_error": f"{type(exc).__name__}: {exc}"} start = load("01_api_radar_start.json") refresh = load("03_api_scan_proof_refresh_live.json") stop = load("05_api_radar_stop.json") status_after_stop = load("07_api_radar_status_after_stop.json") print(json.dumps({     "artifact_dir": str(root),     "start_command_executed": start.get("command_result", {}).get("executed"),     "start_command_ok": start.get("command_result", {}).get("ok"),     "start_failure_reason": start.get("failure_reason"),     "refresh_status": refresh.get("status"),     "refresh_proof_state": refresh.get("proof_state"),     "refresh_scan_runtime_proven": refresh.get("scan_runtime_proven"),     "refresh_ros2_runtime_proven": refresh.get("ros2_runtime_proven"),     "refresh_uses_base_uart": refresh.get("uses_base_uart"),     "refresh_sends_base_motion_commands": refresh.get("sends_base_motion_commands"),     "stop_command_executed": stop.get("command_result", {}).get("executed"),     "stop_command_ok": stop.get("command_result", {}).get("ok"),     "stop_failure_reason": stop.get("failure_reason"),     "status_after_stop_scan_status": status_after_stop.get("scan_status"),     "status_after_stop_fresh_scan_proof_observed": status_after_stop.get("fresh_scan_proof_observed"), }, ensure_ascii=False, indent=2)) PY printf "%s\n" "$ART" 
