## command: remote show-args bringup + learn
Arguments (pass arguments as '<name>:=<value>'):

    'use_sim_time':
        Use simulation clock
        (default: 'false')

    'serial_port':
        UART device for the WAVE ROVER ESP32 controller
        (default: '/dev/ttyUSB0')

    'serial_baudrate':
        UART baud rate for the WAVE ROVER ESP32 controller
        (default: '115200')

    'command_mode':
        WAVE ROVER command mode: speed uses T=1, ros uses T=13
        (default: 'speed')

    'track_width_m':
        WAVE ROVER differential drive track width in meters
        (default: '0.172')

    'max_wheel_speed_mps':
        Wheel speed used to normalize T=1 speed commands
        (default: '1.3')

    'waypoint_file':
        Path to saved waypoint YAML
        (default: '~/.ros/trashbot_maps/waypoints.yaml')

    'delivery_mode':
        Delivery mode: dry_run or waypoint
        (default: 'dry_run')

    'delivery_target':
        Waypoint name for trash station delivery
        (default: 'trash_station')

    'return_target':
        Optional waypoint name to return to after dropoff
        (default: '')

    'elevator_assist_enabled':
        Enable elevator assisted delivery dry-run subflow
        (default: 'false')

    'elevator_assist_mode':
        Elevator assisted delivery mode; dry_run is the only software-only mode
        (default: 'dry_run')

    'elevator_assist_target_floor':
        Target floor used in elevator assisted delivery dry-run records
        (default: '1')

    'elevator_assist_dry_run_failure':
        Optional dry-run failure: door_timeout, target_floor_unconfirmed, unsafe_to_exit
        (default: '')

    'task_record_dir':
        Directory for delivery task records
        (default: '~/.ros/trashbot_tasks')

    'dropoff_timeout_sec':
        Delivery dropoff timeout in seconds
        (default: '30.0')

    'navigation_timeout_sec':
        Delivery navigation timeout in seconds
        (default: '120.0')

    'operator_gateway':
        Start local HTTP operator gateway
        (default: 'false')

    'operator_gateway_host':
        Operator gateway bind host
        (default: '0.0.0.0')

    'operator_gateway_port':
        Operator gateway HTTP port
        (default: '8766')

    'operator_gateway_collect_action':
        Operator gateway collect action name
        (default: '/trashbot/collect_trash')

    'operator_gateway_dropoff_service':
        Operator gateway dropoff confirmation service name
        (default: '/trashbot/confirm_dropoff')

    'operator_status_file':
        Operator gateway status JSON path
        (default: '/tmp/trashbot_operator_status.json')

    'operator_pose_topic':
        Pose topic used by the operator gateway live location view
        (default: '/amcl_pose')

    'operator_hardware_proof_ref':
        Optional software-proof artifact path for diagnostics.hardware_proof (not HIL evidence)
        (default: '')

    'remote_bridge':
        Start outbound 4G remote bridge
        (default: 'false')

    'remote_cloud_base_url':
        Remote cloud base URL for outbound polling
        (default: '')

    'remote_robot_id':
        Remote cloud robot identifier
        (default: 'trashbot-001')

    'remote_auth_token':
        Remote cloud bearer token
        (default: '')

    'remote_poll_interval_sec':
        Remote bridge polling interval in seconds
        (default: '2.0')

    'remote_request_timeout_sec':
        Remote bridge HTTP request timeout in seconds
        (default: '5.0')

    'lidar_enabled':
        Start ROS2 LiDAR driver; default false avoids blocking bringup without serial hardware
        (default: 'false')

    'lidar_serial_port':
        LiDAR serial device confirmed on Orange Pi; /dev/lidar udev symlink is preferred when installed
        (default: '/dev/ttyACM0')

    'lidar_serial_baudrate':
        LiDAR baud rate from docs/vendor/lidar_pkg_ros2-main reference
        (default: '150000')

    'lidar_frame_id':
        LiDAR frame id; must match measured base_link static TF on hardware
        (default: 'laser_frame')

    'lidar_scan_topic':
        LaserScan topic consumed by Nav2/SLAM
        (default: '/scan')

    'lidar_raw_packet_topic':
        Optional raw LiDAR packet topic
        (default: '/lidar/raw_packet')

    'lidar_publish_raw_packets':
        Publish raw 0xAA55 packets for diagnostics
        (default: 'false')

    'lidar_range_min':
        LiDAR LaserScan range_min in meters; tune after real point cloud validation
        (default: '0.05')

    'lidar_range_max':
        LiDAR LaserScan range_max in meters; tune after real point cloud validation
        (default: '8.0')

    'lidar_scan_time':
        LiDAR LaserScan scan_time placeholder in seconds; measure on real hardware
        (default: '0.1')

    'lidar_time_increment':
        LiDAR LaserScan time_increment placeholder in seconds; measure on real hardware
        (default: '0.0001')

    'lidar_tf_x':
        Placeholder LiDAR x offset from base_link in meters; measure on real robot
        (default: '0.0')

    'lidar_tf_y':
        Placeholder LiDAR y offset from base_link in meters; measure on real robot
