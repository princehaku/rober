   279	def normalize_video_source(video_source: str) -> int | str:
   280	    """显式 source 保持兼容：数字走 OpenCV index，路径/URL 按字符串传给后端。"""
   281	    source = str(video_source).strip()
   282	    return int(source) if source.isdigit() else source
   283	
   284	
   285	def open_video_capture(cv2_module: Any, source: int | str) -> Any:
   286	    """Linux video 节点显式走 V4L2 backend，避免 OpenCV 后端自动探测漂移。"""
   287	    if hasattr(cv2_module, "CAP_V4L2") and (isinstance(source, int) or str(source).startswith("/dev/video")):
   288	        return cv2_module.VideoCapture(source, cv2_module.CAP_V4L2)
   289	    return cv2_module.VideoCapture(source)
