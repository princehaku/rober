[Unit]
Description=Trashbot LAN-only local WebRTC camera smoke
Documentation=file:/root/rober/docs/interfaces/o7_local_webrtc_camera_smoke.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/rober
Environment=HOST=0.0.0.0
Environment=PORT=8088
Environment=ROBER_CAMERA_SOURCE=auto
Environment=PYTHONUNBUFFERED=1
# 该服务只启动本地摄像头 HTTP/WebRTC smoke，不启动 ROS2、串口或底盘控制。
ExecStart=/usr/bin/env bash /root/rober/onboard/scripts/local_webrtc_camera_smoke.sh
# 现场摄像头/依赖短暂抖动时允许 systemd 接管重启，避免 operator-run/nohup 漂移。
Restart=on-failure
RestartSec=3
# 安全限制只收紧进程权限；不能禁用 /dev/video*，否则相机 smoke 无法证明真实画面。
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
---
#!/usr/bin/env bash
set -euo pipefail

# 这个启动脚本只封装本地 WebRTC 摄像头 smoke，不碰 ROS2、串口或底盘控制。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${PORT:-8088}"
HOST="${HOST:-0.0.0.0}"
# 默认 auto 会跳过 Orange Pi 的 cedrus/metadata 等不可读节点；现场稳定后可显式设 /dev/video1。
VIDEO_SOURCE="${ROBER_CAMERA_SOURCE:-auto}"
WIDTH="${WIDTH:-640}"
HEIGHT="${HEIGHT:-480}"
FPS="${FPS:-15}"

# 自检模式只访问已经启动的 HTTP/WebRTC smoke，不启动 ROS2/串口/底盘控制。
if [[ -n "${ROBER_WEBRTC_SELF_TEST_URL:-}" ]]; then
  exec python3 "${SCRIPT_DIR}/local_webrtc_camera_smoke.py" \
    --self-test-url "${ROBER_WEBRTC_SELF_TEST_URL}" \
    --self-test-timeout "${ROBER_WEBRTC_SELF_TEST_TIMEOUT:-8}" \
    ${ROBER_WEBRTC_REQUIRE_FRAME:+--require-frame}
fi

# 依赖安装交给现场同学显式处理；脚本本身即使缺依赖也能启动诊断页。
exec python3 "${SCRIPT_DIR}/local_webrtc_camera_smoke.py" \
  --host "${HOST}" \
  --port "${PORT}" \
  --video-source "${VIDEO_SOURCE}" \
  --width "${WIDTH}" \
  --height "${HEIGHT}" \
  --fps "${FPS}"
