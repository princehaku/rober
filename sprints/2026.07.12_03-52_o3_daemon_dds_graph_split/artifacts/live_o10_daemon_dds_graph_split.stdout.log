S),\n    \"which\": run_layer(\"which\", \"which ros2\", PATH_TIMEOUT_S),\n}\nros2_path = \"\"\nfor key in (\"command_v\", \"which\"):\n    candidate = str(path_lookup[key].get(\"stdout\") or \"\").strip().splitlines()\n    if candidate:\n        ros2_path = candidate[0].strip()\n        break\nif ros2_path:\n    cli_invocation = run_layer(\"ros2_help\", \"ros2 --help >/dev/null\", INVOCATION_TIMEOUT_S)\nelse:\n    cli_invocation = {\n        \"label\": \"ros2_help\",\n        \"command\": \"ros2 --help >/dev/null\",\n        \"executed\": False,\n        \"ok\": False,\n        \"timeout_s\": INVOCATION_TIMEOUT_S,\n        \"timed_out\": False,\n        \"boundary\": \"ros2_path_missing_skip_cli_invocation\",\n        \"stdout\": \"\",\n        \"stderr\": \"\",\n    }\npayload = {\n    \"environment\": {\n        \"PATH\": os.environ.get(\"PATH\", \"\"),\n        \"AMENT_PREFIX_PATH\": os.environ.get(\"AMENT_PREFIX_PATH\", \"\"),\n        \"PYTHONPATH\": os.environ.get(\"PYTHONPATH\", \"\"),\n        \"LD_LIBRARY_PATH\": os.environ.get(\"LD_LIBRARY_PATH\", \"\"),\n    },\n    \"path_lookup\": path_lookup,\n    \"ros2_cli_path\": ros2_path or None,\n    \"cli_invocation\": cli_invocation,\n}\nprint(json.dumps(payload, ensure_ascii=False))'", "elapsed_ms": 9555, "executed": true, "finished_at_ms": 1783800201816, "ok": true, "returncode": 0, "started_at_ms": 1783800192261, "stderr": "", "stdout": "{\"environment\": {\"PATH\": \"/opt/ros/humble/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin\", \"AMENT_PREFIX_PATH\": \"/root/rober/onboard/install/ros2_trashbot_bringup:/root/rober/onboard/install/ros2_trashbot_behavior:/root/rober/onboard/install/ros2_trashbot_vision:/root/rober/onboard/install/ros2_trashbot_nav:/root/rober/onboard/install/ros2_trashbot_hardware:/root/rober/onboard/install/ros2_trashbot_interfaces:/opt/ros/humble\", \"PYTHONPATH\": \"/root/rober/onboard/build/ros2_trashbot_behavior:/root/rober/onbo